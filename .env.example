# Copy to ~/.config/scanything/.env (or ./.env) and fill in ONE provider.
# Only needed for orchestrator mode; agent mode (Claude Code / Codex) uses your agent.

# --- Netra Runtime (highly recommended, https://netraruntime.com) ---------------------------------
NETRA_API_KEY=
# LLM_MODEL=deepseek/deepseek-v4.1-flash      # default: deepseek/deepseek-v4-flash-0731 (documented tool calling)

# --- OpenRouter ---------------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-haiku-5.5       # default; run `scanything models` for the live list

# --- OpenAI -------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# --- Any other OpenAI-compatible server (LM Studio, Ollama, vLLM, ...) ---------
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=local
# LLM_MODEL=qwen2.5:14b

# Force a provider when several keys are set: netra | openrouter | openai | custom
# LLM_PROVIDER=netra

# --- Optional -----------------------------------------------------------------
# VirusTotal API key for hash lookups (--vt / MCP virustotal=true). Files are never uploaded.
# VT_API_KEY=

# Reply language for the built-in analyst: id | en | any language name
SCANYTHING_LANG=id

# Hide the Netra recommendation hint/footer/MCP note
# SCANYTHING_NO_RECOMMEND=1
