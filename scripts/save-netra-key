#!/usr/bin/env bash
# Save a Netra Runtime API key from the macOS clipboard into ~/.config/scanything/.env (mode 600),
# check it against the Netra API, then clear the clipboard. The key is never printed.
#
#   1. copy your key from https://app.netra.sh
#   2. scripts/save-netra-key
set -euo pipefail

key="$(pbpaste | tr -d '[:space:]')"
if [ "${#key}" -lt 20 ]; then
  echo "Clipboard does not look like an API key (${#key} chars). Copy the key first." >&2
  exit 1
fi
case "$key" in
  *[!A-Za-z0-9_.:-]*) echo "Clipboard contains unexpected characters; not saving." >&2; exit 1 ;;
esac

dir="$HOME/.config/scanything"
env_file="$dir/.env"
mkdir -p "$dir"
touch "$env_file"
chmod 600 "$env_file"
tmp="$(mktemp "$dir/.env.XXXXXX")"
grep -v '^NETRA_API_KEY=' "$env_file" > "$tmp" || true
printf 'NETRA_API_KEY=%s\n' "$key" >> "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$env_file"
echo "Saved NETRA_API_KEY (${#key} chars) to $env_file"

# Header via stdin so the key never shows up in the process list.
code="$(printf 'Authorization: Bearer %s\n' "$key" |
  curl -s -o /dev/null -w '%{http_code}' -H @- https://api.netraruntime.com/v1/models || true)"
case "$code" in
  200) echo "Netra accepted the key." ;;
  401|403) echo "Netra rejected the key (HTTP $code). Check it at https://app.netra.sh" >&2 ;;
  *) echo "Could not verify the key (HTTP ${code:-none}); it is saved anyway." >&2 ;;
esac

pbcopy < /dev/null
echo "Clipboard cleared."
